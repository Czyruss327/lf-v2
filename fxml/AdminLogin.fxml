<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    AdminLogin.fxml
    Admin login form.
    Left: login form card.
    Right: campus background with logo + app name.
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AdminLoginController"
      stylesheets="@../css/styles.css"
      prefWidth="860" prefHeight="520">

    <!-- ═══ LEFT — Login Form Card ═══ -->
    <VBox alignment="CENTER"
          prefWidth="400" minWidth="340"
          styleClass="admin-login-left">

        <VBox alignment="CENTER" spacing="14" styleClass="admin-login-card">
            <padding><Insets top="36" bottom="36" left="36" right="36"/></padding>

            <!-- Title -->
            <Label text="Admin Login"
                   styleClass="admin-login-title"
                   alignment="CENTER"
                   maxWidth="Infinity"/>

            <!-- Username -->
            <VBox spacing="5">
                <Label text="Username" styleClass="form-label"/>
                <TextField fx:id="usernameField"
                           promptText="Username"
                           styleClass="form-input"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Password"
                               styleClass="form-input"/>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" styleClass="error-label"
                   wrapText="true" maxWidth="Infinity"/>

            <!-- LOGIN Button -->
            <Button text="LOG IN"
                    styleClass="btn-view"
                    maxWidth="Infinity"
                    onAction="#onLogin"/>

            <!-- Forgot password -->
            <HBox alignment="CENTER" spacing="4">
                <Label text="Forgot your password? Click"
                       styleClass="forgot-text"/>
                <Hyperlink text="here"
                           styleClass="forgot-link"
                           onAction="#onForgotPassword"/>
            </HBox>

        </VBox>

    </VBox>

    <!-- ═══ RIGHT — Background + Branding ═══ -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-left-panel">

        <!-- Background image -->
        <ImageView fx:id="bgImage"
                   fitWidth="460" fitHeight="520"
                   preserveRatio="false"/>

        <!-- Dark overlay -->
        <Pane styleClass="login-overlay"/>

        <!-- Logo + title centered -->
        <VBox alignment="CENTER" spacing="16">
            <ImageView fx:id="logoImage"
                       fitWidth="90" fitHeight="90"
                       preserveRatio="true"/>
            <Label text="PUPSRC LOST AND FOUND"
                   styleClass="login-welcome-line2"
                   wrapText="true"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   maxWidth="260"/>
        </VBox>

    </StackPane>

</HBox>
