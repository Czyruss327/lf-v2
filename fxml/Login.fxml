<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    Login.fxml
    Welcome / role-selection screen.
    Left half: campus background image with welcome text.
    Right half: white card with logo, app name, ADMIN and STUDENT buttons.
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController"
      stylesheets="@../css/styles.css"
      prefWidth="860" prefHeight="520">

    <!-- ═══ LEFT PANEL — background image + welcome text ═══ -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-left-panel">

        <!-- Background image (set via controller or CSS) -->
        <ImageView fx:id="bgImage"
                   fitWidth="430" fitHeight="520"
                   preserveRatio="false"/>

        <!-- Dark overlay -->
        <Pane styleClass="login-overlay"/>

        <!-- Welcome text -->
        <VBox alignment="BOTTOM_LEFT">
            <padding><Insets bottom="60" left="40" right="40"/></padding>
            <Label text="WELCOME TO" styleClass="login-welcome-line1"/>
            <Label text="PUPSRC LOST AND" styleClass="login-welcome-line2"/>
            <Label text="FOUND" styleClass="login-welcome-line2"/>
        </VBox>

    </StackPane>

    <!-- ═══ RIGHT PANEL — white card ═══ -->
    <VBox alignment="CENTER" spacing="0"
          styleClass="login-right-panel"
          prefWidth="320" minWidth="280">

        <!-- Card -->
        <VBox alignment="CENTER" spacing="18" styleClass="login-card">
            <padding><Insets top="48" bottom="48" left="40" right="40"/></padding>

            <!-- Logo -->
            <ImageView fx:id="logoImage"
                       fitWidth="80" fitHeight="80"
                       preserveRatio="true"/>

            <!-- App Name -->
            <Label text="PUPSRC LOST AND FOUND"
                   styleClass="login-app-title"
                   wrapText="true"
                   alignment="CENTER"
                   textAlignment="CENTER"/>

            <!-- Spacer -->
            <Region prefHeight="10"/>

            <!-- ADMIN Button -->
            <Button fx:id="adminBtn"
                    text="ADMIN"
                    styleClass="login-role-btn"
                    maxWidth="Infinity"
                    onAction="#onAdminLogin"/>

            <!-- STUDENT Button -->
            <Button fx:id="studentBtn"
                    text="STUDENT"
                    styleClass="login-role-btn-outline"
                    maxWidth="Infinity"
                    onAction="#onStudentLogin"/>

        </VBox>

    </VBox>

</HBox>
